{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cheslaunchengine.dev/schemas/cle.schema.json",
  "title": "ChesLaunchEngine configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Configuration schema version."
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gameDirectory": { "type": "string" },
        "versionsDirectory": { "type": "string" }
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "argumentMode": { "type": "string", "enum": ["auto", "legacy", "modern"], "default": "auto" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "default": 3600 }
      }
    },
    "download": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 64, "default": 8 },
        "retries": { "type": "integer", "minimum": 0, "maximum": 10, "default": 3 },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "default": 300 },
        "offline": { "type": "boolean", "default": false }
      }
    },
    "java": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" }
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "description": "Account profile storage settings; never put tokens or passwords in this file.",
      "properties": {
        "defaultProvider": { "type": "string", "enum": ["", "offline", "yggdrasil", "microsoft"], "description": "Default account provider." },
        "credentialStore": { "type": "string", "enum": ["", "os"], "default": "os", "description": "Operating-system credential store (Windows Credential Manager, macOS Keychain, or Linux Secret Service). Empty uses the OS store." },
        "storePath": { "type": "string", "description": "Path for non-sensitive account profiles." },
        "microsoft": {
          "type": "object",
          "additionalProperties": false,
          "description": "Microsoft Account authentication settings. The clientId is an application (public client) identifier owned by the operator; CLE never bundles a hard-coded Client ID or Client Secret.",
          "properties": {
            "clientId": { "type": "string", "description": "OAuth 2.0 public client application ID. May also be provided via the CLE_MICROSOFT_CLIENT_ID environment variable." }
          }
        }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": { "type": "string", "enum": ["DEBUG", "INFO", "WARN", "ERROR"], "default": "INFO" },
        "console": { "type": "boolean", "default": true },
        "directory": { "type": "string" },
        "instanceId": { "type": "string" }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "description": "Reserved configuration only; no HTTP API server is implemented.",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "address": { "type": "string", "default": "127.0.0.1:8765" }
      }
    },
    "debugTerminal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "historyLimit": { "type": "integer", "minimum": 0, "maximum": 10000, "default": 1000 }
      }
    }
  }
}
